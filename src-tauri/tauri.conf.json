{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myclean",
  "version": "1.0.0",
  "identifier": "com.myclean.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "myclean",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: http://tauri.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: tauri: http://tauri.localhost; font-src 'self' asset: data: tauri:; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost tauri:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "copyright": "Copyright © 2026 myclean. All rights reserved.",
    "shortDescription": "High-performance, privacy-first macOS cleaner and optimization studio",
    "longDescription": "myclean is a high-performance, privacy-first macOS cleaner and optimization studio with a Futuristic Premium interface.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 380
        },
        "appPosition": {
          "x": 160,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 440,
          "y": 180
        }
      }
    }
  }
}
